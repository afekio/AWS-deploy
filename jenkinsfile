pipeline {
    agent any

    environment {
        GITHUB_REPO = 'https://github.com/afekio/AWS-deploy.git'
        BRANCH = 'tf-deploy'
        SKIP_BUILD = 'false'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Validate Push Branch') {
            steps {
                script {
                    def detectedBranch = env.BRANCH_NAME ?: (env.GIT_BRANCH ? env.GIT_BRANCH.replaceFirst('^origin/', '') : '')
                    echo "Webhook received for branch: ${detectedBranch}"

                    if (detectedBranch && detectedBranch != env.BRANCH) {
                        echo "Skipping build: configured branch is ${env.BRANCH}"
                        env.SKIP_BUILD = 'true'
                        currentBuild.description = "Skipped branch ${detectedBranch}"
                    }
                }
            }
        }

        stage('Build Docker Images') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                script {
                    sh 'ls -al'
                    echo 'Building Docker images...'

                    def dockerfilesOutput = sh(
                        script: "find . -type f \\( -iname 'dockerfile' -o -name 'Dockerfile' \\) -not -path './.git/*' | sort",
                        returnStdout: true
                    ).trim()

                    if (!dockerfilesOutput) {
                        echo 'Warning: no dockerfiles found in this branch'
                        return
                    }

                    def dockerfiles = dockerfilesOutput.split('\n')
                    echo "Found ${dockerfiles.size()} dockerfile(s)"

                    for (String dockerfilePath : dockerfiles) {
                        String contextDir = dockerfilePath.replaceFirst('/[^/]+$', '')
                        if (!contextDir) {
                            contextDir = '.'
                        }

                        String imageTag = contextDir
                            .replaceFirst('^\\./', '')
                            .replaceAll('[^A-Za-z0-9._/-]', '-')
                            .replaceAll('/', '-')
                            .toLowerCase()

                        if (!imageTag) {
                            imageTag = 'root'
                        }

                        echo "Building image ${imageTag}-service from ${dockerfilePath}"
                        sh "docker build -t ${imageTag}-service ${contextDir} -f ${dockerfilePath}"
                        echo "Built ${imageTag}-service successfully"
                    }

                    echo 'All Docker images built successfully!'
                }
            }
        }
    }
}