pipeline {
    agent any

    environment {
        GITHUB_REPO = 'https://github.com/afekio/AWS-deploy.git'
        BRANCH = 'tf-deploy'
        SKIP_BUILD = 'false'
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Clone Code') {
            steps {
                deleteDir()
                git branch: "${env.BRANCH}", url: "${env.GITHUB_REPO}"
            }
        }

        stage('Validate Push Branch') {
            steps {
                script {
                    def detectedBranch = env.BRANCH_NAME ?: (env.GIT_BRANCH ? env.GIT_BRANCH.replaceFirst('^origin/', '') : env.BRANCH)
                    echo "Webhook received for branch: ${detectedBranch}"

                    if (detectedBranch && detectedBranch != env.BRANCH) {
                        echo "Skipping build: configured branch is ${env.BRANCH}"
                        env.SKIP_BUILD = 'true'
                        currentBuild.description = "Skipped branch ${detectedBranch}"
                    }
                }
            }
        }

        stage('Build Docker Images') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            steps {
                script {
                    echo 'Building Docker images...'

                    sh 'docker build -t auth-service ./Auth -f ./Auth/dockerfile'
                    sh 'docker build -t backend-service ./Backend -f ./Backend/dockerfile'
                    sh 'docker build -t frontend-service ./Frontend -f ./Frontend/dockerfile'

                    echo 'All Docker images built successfully!'
                }
            }
        }
    }
}